# ==============================================================================
# Copy file này thành .env trên VPS (cùng thư mục docker-compose.yml) rồi điền giá trị thật
#   cp .env.example .env && nano .env
# KHÔNG commit file .env lên Git.
#
# Biến của backend (MONGO_URI, JWT_SECRET, ALLOWED_ORIGINS...) cấu hình trên
# Azure Portal -> demo-webtraiga -> Containers -> Environment variables, không đặt ở đây.
# ==============================================================================

# IP public của VPS (để client WebRTC kết nối)
CANDIDATE=103.82.26.60

# URL backend trên Azure Container Apps (KHÔNG có dấu / ở cuối)
# Lấy ở Azure Portal -> demo-webtraiga -> Overview -> Application Url
BACKEND_URL=https://demo-webtraiga.proudsky-59d95604.southeastasia.azurecontainerapps.io

# Mã bí mật bảo vệ SRS Webhook (/auth, /auth/unpublish, /auth/dvr) - đặt giống hệt trên Backend Azure
SRS_WEBHOOK_SECRET=your_srs_webhook_secret_token

# Chứng chỉ công khai cho SRS HTTPS: fullchain.pem và privkey.pem tại /opt/traiga/certs/

# Google Drive OAuth2 (cấu hình ở GitHub Secrets của repo BE để backend Azure tự upload DVR)
# GOOGLE_DRIVE_CLIENT_ID=...
# GOOGLE_DRIVE_CLIENT_SECRET=...
# GOOGLE_DRIVE_REFRESH_TOKEN=...
# GOOGLE_DRIVE_FOLDER_ID=...
